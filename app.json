{
  "expo": {
    "name": "Swach City",
    "slug": "cleani-city-mobile",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./logos/swach_app_logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./logos/swach_app_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B6B3A"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cleani.city.mobile"
    },
    "android": {
      "package": "com.cleani.city.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1B6B3A",
        "foregroundImage": "./logos/swach_app_logo.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "gradleProperties": {
              "org.gradle.parallel": "true",
              "org.gradle.caching": "true",
              "org.gradle.daemon": "true",
              "org.gradle.workers.max": "2",
              "org.gradle.jvmargs": "-Xmx3g -XX:MaxMetaspaceSize=512m -Dfile.encoding=UTF-8",
              "reactNativeArchitectures": "armeabi-v7a,arm64-v8a,x86,x86_64",
              "android.useAndroidX": "true"
            }
          }
        }
      ],
      "./plugins/withDisableWorkManagerAutoInit.js",
      "expo-router"
    ],
    "extra": {
      "apiUrl": "http://192.168.1.8:3000/api",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5d73a99c-5c37-465b-932f-532078556665"
      }
    },
    "owner": "cklacki"
  }
}
